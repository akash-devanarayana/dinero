{
  "name": "dinero",
  "private": true,
  "version": "1.0.0",
  "description": "Personal expense tracker — frontend bundle build",
  "scripts": {
    "build": "esbuild dinero-entry.js styles/index.css --bundle --entry-names=dinero --outdir=dist --minify --sourcemap",
